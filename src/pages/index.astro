---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Inaya.</h1>
			<p>
				I'm 19 and agender. Being physically disabled means I depend on other
				people for most physical things. My brain works, though... probably... I
				hope... 🫠
			</p>
			<p>
				I'm a software developer who loves art. I spend a lot of time making
				things, taking them apart and trying to understand why they work.
			</p>
			<p>
				If you want the much longer version, there's an
				<a href="/about">about page</a>. The
				<a href="/projects">projects page</a> is empty. One thing at a time.
			</p>
		</main>
		<Footer />
	</body>
</html>
