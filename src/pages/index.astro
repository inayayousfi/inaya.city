---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi! Welcome to my cavern!</h1>
			<p>
				Welcome to my personal website. (built with
				<a href="https://astro.build/">Astro</a>)
				I hope you find something interesting here!
			</p>
			<p>
				I have set this up as a simple blog and portfolio site. Feel free to
				browse around and check out my
				<a href="https://github.com/ZiedYousfi">GitHub</a>.
			</p>
			<p>
				You can also see my artistic projects <a href="/projects">here</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
