---
import BaseHead from "../../../components/BaseHead.astro";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import { SITE_TITLE } from "../../../consts";

const artworks = [
  {
    title: "Lorem Ipsum",
    year: "20XX",
    description:
      "A placeholder poster testing how independent artwork can live beside the main site.",
    href: "/projects/art/lorem-ipsum/index.html",
    preview: "/projects/art/lorem-ipsum/preview.svg",
    medium: "HTML, CSS, and SVG",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE + " | Art Projects"}
      description="Visual work and standalone web pieces by Inaya Yousfi."
    />
    <style>
      .intro {
        margin-bottom: 2.5rem;
      }
      .eyebrow {
        margin: 0 0 0.5rem;
        color: var(--accent);
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .intro p:last-child {
        margin-bottom: 0;
        color: rgb(var(--gray));
      }
      .art-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .art-card a {
        display: block;
        overflow: hidden;
        border: 1px solid rgba(var(--gray), 0.28);
        border-radius: var(--card-radius);
        background: rgba(var(--gray-light), 0.45);
        color: inherit;
        text-decoration: none;
      }
      .art-card a:hover,
      .art-card a:focus-visible {
        transform: translateY(var(--card-lift));
        border-color: var(--accent);
      }
      .art-card a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      .art-card img {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 0;
      }
      .art-card .copy {
        padding: 1rem 1.1rem 1.2rem;
      }
      .art-card .meta {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin: 0 0 0.4rem;
        color: rgb(var(--gray));
        font-size: 0.75rem;
      }
      .art-card h2 {
        margin-bottom: 0.4rem;
        font-size: 1.5rem;
      }
      .art-card .description {
        margin: 0;
        font-size: 0.88rem;
        line-height: 1.55;
      }
      @media (max-width: 700px) {
        .art-grid {
          grid-template-columns: 1fr;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .art-card a:hover,
        .art-card a:focus-visible {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="intro">
        <p class="eyebrow"><a href="/projects/">Projects</a> / Art</p>
        <h1>Art</h1>
        <p>
          Each work can set its own rules. Some links leave this site's layout
          completely and open the piece itself.
        </p>
      </div>
      <ul class="art-grid">
        {
          artworks.map((artwork) => (
            <li class="art-card">
              <a href={artwork.href}>
                <img src={artwork.preview} alt="" />
                <div class="copy">
                  <p class="meta">
                    <span>{artwork.medium}</span>
                    <span>{artwork.year}</span>
                  </p>
                  <h2>{artwork.title}</h2>
                  <p class="description">{artwork.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <Footer />
  </body>
</html>
