---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE + " | Blog"}
      description="Posts, notes and whatever I felt like writing down."
    />
    <style>
      main {
        width: var(--content-width);
      }
      ul {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li a {
        display: block;
        padding: 1rem 1.25rem;
        border: 1px solid rgba(var(--gray), 0.25);
        border-radius: var(--card-radius);
        text-decoration: none;
        background-color: rgba(var(--gray-light), 0.35);
      }
      ul li a:hover,
      ul li a:focus-visible {
        border-color: var(--accent);
        background-color: rgba(var(--gray-light), 0.85);
      }
      ul li a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .date {
        margin: 0 0 0.25rem 0;
        color: rgb(var(--gray));
        font-size: 0.8rem;
        line-height: 1.4;
      }
      .row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        font-size: 1.25rem;
        line-height: 1.3;
      }
      .arrow {
        flex-shrink: 0;
        color: rgb(var(--gray));
      }
      ul li a:hover .title,
      ul li a:focus-visible .title {
        color: var(--accent);
      }
      ul li a:hover .arrow,
      ul li a:focus-visible .arrow {
        color: var(--accent);
        transform: translateX(var(--card-arrow-shift));
      }
      .empty {
        color: rgb(var(--gray));
      }
      @media (prefers-reduced-motion: reduce) {
        ul li a:hover .arrow,
        ul li a:focus-visible .arrow {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        {
          posts.length === 0 ? (
            <p class="empty">No posts yet.</p>
          ) : (
            <ul>
              {posts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    <p class="date">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                    <div class="row">
                      <h4 class="title">{post.data.title}</h4>
                      <span class="arrow" aria-hidden="true">
                        &rarr;
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
