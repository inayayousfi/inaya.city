---
const projects = [
  {
    title: "Lorem Company Project",
    summary:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. This placeholder tests company work.",
    company: "Lorem Company",
    problem: "A placeholder business problem needed a dependable technical answer.",
    contribution: "Designed and delivered the placeholder implementation.",
    constraints: "Private systems, limited time, and incomplete information.",
    outcome: "The placeholder workflow became simpler and easier to inspect.",
    destinations: [
      { label: "Example destination", href: "https://example.com/" },
    ],
  },
];
---

<section
  class="software-category"
  id="company-projects"
  data-category="company-projects"
  data-count={projects.length}
>
  <header class="category-heading">
    <p class="command"><span>$</span> list company-projects</p>
    <h2>Company Projects</h2>
  </header>
  <div class="output-heading" aria-hidden="true">
    <span>Project</span><span>Details</span><span>Links</span>
  </div>
  <div class="project-rows">
    {
      projects.map((project) => (
        <details class="project-row" open>
          <summary>
            <span class="project-title">{project.title}</span>
            <span class="project-summary">{project.summary}</span>
            <span class="disclosure-label" aria-hidden="true">inspect</span>
          </summary>
          <div class="row-content">
            <dl class="project-details">
              <div><dt>Company</dt><dd>{project.company}</dd></div>
              <div><dt>Problem</dt><dd>{project.problem}</dd></div>
              <div><dt>Contribution</dt><dd>{project.contribution}</dd></div>
              <div><dt>Constraints</dt><dd>{project.constraints}</dd></div>
              <div><dt>Outcome</dt><dd>{project.outcome}</dd></div>
            </dl>
            <ul class="project-destinations" aria-label={`${project.title} links`}>
              {project.destinations.map((destination) => (
                <li><a href={destination.href}>{destination.label}</a></li>
              ))}
            </ul>
          </div>
        </details>
      ))
    }
  </div>
</section>
